{
  "components": {
    "schemas": {
      "CreateReviewRequest": {
        "additionalProperties": false,
        "properties": {
          "lang": {
            "$ref": "#/components/schemas/Language",
            "description": "Declared language of the text: the UI language at submit time"
          },
          "rating": {
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Rating",
            "type": "integer"
          },
          "text": {
            "description": "Counted in Unicode code points after normalization: trimmed, NFC, control and invisible format characters removed (the emoji joiner is kept). Links are rejected.",
            "maxLength": 1000,
            "minLength": 10,
            "title": "Text",
            "type": "string"
          },
          "turnstileToken": {
            "maxLength": 2048,
            "minLength": 1,
            "title": "Turnstiletoken",
            "type": "string"
          }
        },
        "required": [
          "rating",
          "text",
          "lang",
          "turnstileToken"
        ],
        "title": "CreateReviewRequest",
        "type": "object"
      },
      "ErrorCode": {
        "enum": [
          "validation_failed",
          "turnstile_failed",
          "rate_limited",
          "not_found",
          "method_not_allowed",
          "service_unavailable",
          "not_implemented",
          "internal"
        ],
        "title": "ErrorCode",
        "type": "string"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "fields": {
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "title": "Fields",
            "type": "array"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "FieldError": {
        "additionalProperties": false,
        "properties": {
          "field": {
            "title": "Field",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "reason": {
            "$ref": "#/components/schemas/FieldReason"
          }
        },
        "required": [
          "field",
          "message",
          "reason"
        ],
        "title": "FieldError",
        "type": "object"
      },
      "FieldReason": {
        "enum": [
          "missing",
          "invalid",
          "too_short",
          "too_long",
          "links_not_allowed",
          "unknown_field"
        ],
        "title": "FieldReason",
        "type": "string"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "$ref": "#/components/schemas/ServiceStatus"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "Language": {
        "enum": [
          "ru",
          "en"
        ],
        "title": "Language",
        "type": "string"
      },
      "Review": {
        "additionalProperties": false,
        "properties": {
          "createdAt": {
            "format": "date-time",
            "title": "Createdat",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "lang": {
            "$ref": "#/components/schemas/Language",
            "description": "Language of the returned text"
          },
          "rating": {
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Rating",
            "type": "integer"
          },
          "text": {
            "title": "Text",
            "type": "string"
          },
          "translated": {
            "description": "True when the text is a translation of the original",
            "title": "Translated",
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "rating",
          "text",
          "lang",
          "translated",
          "createdAt"
        ],
        "title": "Review",
        "type": "object"
      },
      "ReviewAccepted": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "const": "pending",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "ReviewAccepted",
        "type": "object"
      },
      "ReviewList": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "description": "Approved reviews only, newest first",
            "items": {
              "$ref": "#/components/schemas/Review"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "ReviewList",
        "type": "object"
      },
      "ServiceStatus": {
        "enum": [
          "ok"
        ],
        "title": "ServiceStatus",
        "type": "string"
      },
      "VisitStats": {
        "additionalProperties": false,
        "properties": {
          "today": {
            "description": "Unique visitors today",
            "minimum": 0.0,
            "title": "Today",
            "type": "integer"
          },
          "total": {
            "description": "Sum of daily unique visitors; a returning visitor counts again",
            "minimum": 0.0,
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "today",
          "total"
        ],
        "title": "VisitStats",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Neuroctivity API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "read_health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "internal"
          }
        },
        "summary": "Read Health",
        "tags": [
          "health"
        ]
      }
    },
    "/api/reviews": {
      "get": {
        "operationId": "list_reviews",
        "parameters": [
          {
            "in": "query",
            "name": "lang",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Language"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewList"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "validation_failed"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "internal"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "service_unavailable"
          }
        },
        "summary": "List Reviews",
        "tags": [
          "reviews"
        ]
      },
      "post": {
        "operationId": "create_review",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateReviewRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewAccepted"
                }
              }
            },
            "description": "Successful Response"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "turnstile_failed"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "validation_failed"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "rate_limited",
            "headers": {
              "Retry-After": {
                "description": "Seconds until the next request may be accepted",
                "schema": {
                  "minimum": 1,
                  "type": "integer"
                }
              }
            }
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "internal"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "service_unavailable"
          }
        },
        "summary": "Create Review",
        "tags": [
          "reviews"
        ]
      }
    },
    "/api/stats": {
      "get": {
        "operationId": "read_stats",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VisitStats"
                }
              }
            },
            "description": "Successful Response"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "internal"
          },
          "501": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "not_implemented"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "service_unavailable"
          }
        },
        "summary": "Read Stats",
        "tags": [
          "stats",
          "planned"
        ]
      }
    },
    "/api/visit": {
      "post": {
        "operationId": "record_visit",
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "rate_limited",
            "headers": {
              "Retry-After": {
                "description": "Seconds until the next request may be accepted",
                "schema": {
                  "minimum": 1.0,
                  "type": "integer"
                }
              }
            }
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "internal"
          },
          "501": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "not_implemented"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "service_unavailable"
          }
        },
        "summary": "Record Visit",
        "tags": [
          "stats",
          "planned"
        ]
      }
    }
  }
}
